[global]
ioengine=libaio
direct=1
time_based=1
runtime=600
ramp_time=60
group_reporting=0
invalidate=1
lat_percentiles=1
percentile_list=95:99:99.9

[data-8k]
directory=/u02/oradata
filename=sprint30-data.fio
rw=randrw
rwmixread=70
bs=8k
size=32G
numjobs=4
iodepth=16

[redo]
directory=/u03/redo
filename=sprint30-redo.fio
rw=write
bs=4k
size=4G
numjobs=1
iodepth=1
fdatasync=1

[fra-1m]
directory=/u04/fra
filename=sprint30-fra.fio
rw=readwrite
bs=1M
size=16G
numjobs=1
iodepth=8
rate=120M
